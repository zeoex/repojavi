// Fedexpress — esquema relacional (PostgreSQL)
// Importes monetarios: Decimal(12,2). Nunca Float.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────── Usuarios, roles y autenticación ─────────────────────────

enum PlatformRole {
  CUSTOMER
  SUPERADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  // Rol de plataforma. Siempre CUSTOMER al registrarse; SUPERADMIN solo vía script seguro.
  platformRole  PlatformRole @default(CUSTOMER)
  status        UserStatus   @default(ACTIVE)
  phone         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  accounts         Account[]
  sessions         Session[]
  memberships      MerchantUser[]
  customerProfile  CustomerProfile?
  addresses        Address[]
  carts            Cart[]
  orders           Order[]
  courierProfiles  Courier[]
  auditLogs        AuditLog[]
  statusChanges    OrderStatusHistory[]

  @@index([platformRole])
}

// Tablas estándar de NextAuth (adapter Prisma)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CustomerProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  phone              String?
  // Preparado para datos fiscales (DNI/CUIT) si en el futuro se requieren comprobantes.
  documentType       String?
  documentNumber     String?
  marketingOptIn     Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Comercios ─────────────────────────

enum MerchantStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum MerchantRole {
  OWNER
  ADMIN
}

model Merchant {
  id           String         @id @default(cuid())
  slug         String         @unique
  name         String
  description  String?
  businessType String         @default("Almacén")
  phone        String?
  email        String?
  logoUrl      String?
  coverUrl     String?
  // Dirección de origen (retiro de pedidos)
  street       String?
  streetNumber String?
  city         String?
  province     String?
  postalCode   String?
  // Preparado para geolocalización futura
  latitude     Decimal?       @db.Decimal(9, 6)
  longitude    Decimal?       @db.Decimal(9, 6)
  // Info fiscal/comercial (opcional, no se inventan requisitos)
  legalName    String?
  taxId        String?
  status       MerchantStatus @default(PENDING)
  salesPaused  Boolean        @default(false)
  featured     Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  members        MerchantUser[]
  settings       MerchantSettings?
  paymentAccount MerchantPaymentAccount?
  hours          MerchantHours[]
  categories     Category[]
  products       Product[]
  zones          DeliveryZone[]
  couriers       Courier[]
  carts          Cart[]
  orders         Order[]

  @@index([status, deletedAt])
  @@index([name])
}

model MerchantUser {
  id         String       @id @default(cuid())
  merchantId String
  userId     String
  role       MerchantRole @default(ADMIN)
  createdAt  DateTime     @default(now())
  merchant   Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([merchantId, userId])
  @@index([userId])
}

model MerchantSettings {
  id                       String   @id @default(cuid())
  merchantId               String   @unique
  minOrderAmount           Decimal  @default(0) @db.Decimal(12, 2)
  // Minutos que dura la reserva de stock de un pedido pendiente de pago
  reservationMinutes       Int      @default(30)
  // Hasta qué estado el cliente puede cancelar
  allowCustomerCancelPaid  Boolean  @default(true)
  pickupEnabled            Boolean  @default(false)
  updatedAt                DateTime @updatedAt
  merchant                 Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model MerchantHours {
  id         String   @id @default(cuid())
  merchantId String
  dayOfWeek  Int // 0 = domingo … 6 = sábado
  opensAt    String // "HH:MM" hora de Argentina
  closesAt   String // "HH:MM"
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, dayOfWeek])
}

enum PaymentAccountStatus {
  CONNECTED
  EXPIRED
  REVOKED
  ERROR
}

model MerchantPaymentAccount {
  id                 String               @id @default(cuid())
  merchantId         String               @unique
  provider           String               @default("MERCADOPAGO")
  // user_id del vendedor en Mercado Pago (collector)
  providerUserId     String
  // Tokens cifrados con AES-256-GCM (ENCRYPTION_KEY). Nunca se exponen.
  accessTokenEnc     String               @db.Text
  refreshTokenEnc    String?              @db.Text
  publicKey          String?
  scope              String?
  liveMode           Boolean              @default(false)
  expiresAt          DateTime?
  status             PaymentAccountStatus @default(CONNECTED)
  lastError          String?
  connectedAt        DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  merchant           Merchant             @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([providerUserId])
}

// ───────────────────────── Catálogo e inventario ─────────────────────────

model Category {
  id         String    @id @default(cuid())
  // null = categoría global de la plataforma; con valor = categoría propia del comercio
  merchantId String?
  name       String
  slug       String
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([merchantId, slug])
  @@index([slug])
}

model Product {
  id          String           @id @default(cuid())
  merchantId  String
  categoryId  String?
  name        String
  description String?
  active      Boolean          @default(true)
  featured    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  merchant    Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  category    Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images      ProductImage[]
  variants    ProductVariant[]

  @@index([merchantId, active, deletedAt])
  @@index([categoryId])
  @@index([name])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// Todo producto tiene al menos una variante ("Única"). Precio, SKU y stock viven en la variante.
model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  merchantId String // desnormalizado para garantizar el aislamiento y la unicidad de SKU por comercio
  name       String      @default("Única")
  sku        String
  price      Decimal     @db.Decimal(12, 2)
  promoPrice Decimal?    @db.Decimal(12, 2)
  active     Boolean     @default(true)
  sortOrder  Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory  Inventory?
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([merchantId, sku])
  @@index([productId])
}

model Inventory {
  id        String              @id @default(cuid())
  variantId String              @unique
  // Unidades físicas en el comercio
  quantity  Int                 @default(0)
  // Unidades reservadas por pedidos pendientes de pago
  reserved  Int                 @default(0)
  minStock  Int?
  updatedAt DateTime            @updatedAt
  variant   ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]
}

enum InventoryMovementType {
  ADJUSTMENT // ajuste manual del comercio
  RESERVE // reserva por pedido pendiente
  RELEASE // liberación de reserva (vencido / rechazado / cancelado)
  COMMIT // descuento definitivo por pago aprobado
  RESTOCK // devolución de stock por cancelación de pedido pagado
}

model InventoryMovement {
  id          String                @id @default(cuid())
  inventoryId String
  type        InventoryMovementType
  // delta sobre quantity y reserved
  quantityDelta Int                 @default(0)
  reservedDelta Int                 @default(0)
  orderId     String?
  actorId     String?
  note        String?
  createdAt   DateTime              @default(now())
  inventory   Inventory             @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId, createdAt])
  @@index([orderId])
}

// ───────────────────────── Carritos y direcciones ─────────────────────────

model Cart {
  id         String     @id @default(cuid())
  userId     String
  merchantId String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant   Merchant   @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  items      CartItem[]

  // Un carrito por comercio y por usuario
  @@unique([userId, merchantId])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

model Address {
  id           String    @id @default(cuid())
  userId       String
  label        String?
  street       String
  streetNumber String
  apartment    String?
  city         String
  province     String
  postalCode   String
  instructions String?
  contactName  String?
  contactPhone String?
  latitude     Decimal?  @db.Decimal(9, 6)
  longitude    Decimal?  @db.Decimal(9, 6)
  isDefault    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────── Delivery ─────────────────────────

model DeliveryZone {
  id              String   @id @default(cuid())
  merchantId      String
  name            String
  // Códigos postales cubiertos (MVP sin geocodificación). Ej: ["C1414","1414"]
  postalCodes     String[]
  // Costo de envío (DeliveryFee) de la zona
  fee             Decimal  @db.Decimal(12, 2)
  // Envío gratis a partir de este subtotal (opcional)
  freeShippingOver Decimal? @db.Decimal(12, 2)
  minOrderAmount  Decimal  @default(0) @db.Decimal(12, 2)
  etaMinMinutes   Int      @default(30)
  etaMaxMinutes   Int      @default(60)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  merchant        Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, active])
}

model Courier {
  id         String     @id @default(cuid())
  merchantId String
  // Usuario que inicia sesión como repartidor (vinculado por email)
  userId     String?
  name       String
  phone      String?
  email      String
  vehicle    String?
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  merchant   Merchant   @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  deliveries Delivery[]

  @@unique([merchantId, email])
  @@index([userId])
}

enum DeliveryStatus {
  PENDING_ASSIGNMENT
  ASSIGNED
  ACCEPTED
  PICKED_UP
  DELIVERED
  FAILED
  CANCELLED
}

model Delivery {
  id           String          @id @default(cuid())
  orderId      String          @unique
  merchantId   String
  courierId    String?
  status       DeliveryStatus  @default(PENDING_ASSIGNMENT)
  assignedAt   DateTime?
  acceptedAt   DateTime?
  pickedUpAt   DateTime?
  deliveredAt  DateTime?
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier      Courier?        @relation(fields: [courierId], references: [id], onDelete: SetNull)
  events       DeliveryEvent[]

  @@index([merchantId, status])
  @@index([courierId, status])
}

model DeliveryEvent {
  id         String         @id @default(cuid())
  deliveryId String
  status     DeliveryStatus
  actorId    String?
  note       String?
  // Preparado para seguimiento en tiempo real futuro (no se simula GPS)
  latitude   Decimal?       @db.Decimal(9, 6)
  longitude  Decimal?       @db.Decimal(9, 6)
  createdAt  DateTime       @default(now())
  delivery   Delivery       @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId, createdAt])
}

// ───────────────────────── Pedidos ─────────────────────────

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  READY
  COURIER_ASSIGNED
  ON_THE_WAY
  DELIVERED
  CANCELLED
  PAYMENT_REJECTED
  REFUND_PENDING
  REFUNDED
}

model Order {
  id                 String      @id @default(cuid())
  // Número legible y secuencial
  number             Int         @unique @default(autoincrement())
  userId             String
  merchantId         String
  status             OrderStatus @default(PENDING_PAYMENT)
  // Snapshot de importes al momento de la compra
  subtotal           Decimal     @db.Decimal(12, 2)
  discountTotal      Decimal     @default(0) @db.Decimal(12, 2)
  shippingFee        Decimal     @db.Decimal(12, 2)
  total              Decimal     @db.Decimal(12, 2)
  currency           String      @default("ARS")
  // Snapshot de entrega
  deliveryZoneName   String?
  etaMinMinutes      Int?
  etaMaxMinutes      Int?
  shipStreet         String
  shipStreetNumber   String
  shipApartment      String?
  shipCity           String
  shipProvince       String
  shipPostalCode     String
  shipInstructions   String?
  contactName        String
  contactPhone       String
  customerEmail      String
  merchantNameSnapshot String
  // Reserva de stock
  stockReserved      Boolean     @default(false)
  stockCommitted     Boolean     @default(false)
  reservationExpiresAt DateTime?
  // Idempotencia de creación (evita pedidos duplicados por doble click)
  idempotencyKey     String      @unique
  cancelReason       String?
  paidAt             DateTime?
  deliveredAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user          User                 @relation(fields: [userId], references: [id])
  merchant      Merchant             @relation(fields: [merchantId], references: [id])
  items         OrderItem[]
  payments      Payment[]
  delivery      Delivery?
  statusHistory OrderStatusHistory[]

  @@index([merchantId, status, createdAt])
  @@index([userId, createdAt])
  @@index([status, reservationExpiresAt])
}

model OrderItem {
  id           String         @id @default(cuid())
  orderId      String
  variantId    String
  // Copia histórica: no cambia si cambia el catálogo
  productName  String
  variantName  String
  sku          String
  imageUrl     String?
  unitPrice    Decimal        @db.Decimal(12, 2)
  quantity     Int
  lineTotal    Decimal        @db.Decimal(12, 2)
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorId    String?
  // USER | SYSTEM | WEBHOOK
  actorType  String       @default("USER")
  note       String?
  createdAt  DateTime     @default(now())
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor      User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

// ───────────────────────── Pagos ─────────────────────────

enum PaymentProvider {
  MERCADOPAGO
  DEMO // pago SIMULADO, solo para demostraciones en entornos no productivos
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  CHARGED_BACK
  IN_PROCESS
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String
  merchantId        String
  provider          PaymentProvider
  isSimulated       Boolean         @default(false)
  preferenceId      String?
  // id de pago de Mercado Pago (único por proveedor)
  providerPaymentId String?
  status            PaymentStatus   @default(PENDING)
  statusDetail      String?
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @default("ARS")
  collectorId       String?
  approvedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds           Refund[]
  events            PaymentEvent[]

  @@unique([provider, providerPaymentId])
  @@index([orderId])
  @@index([merchantId, status])
}

model PaymentEvent {
  id          String    @id @default(cuid())
  provider    String
  // Clave de idempotencia de la notificación (ej: "payment:123:approved")
  eventKey    String    @unique
  paymentId   String?
  topic       String?
  resourceId  String?
  signatureOk Boolean   @default(false)
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())
  payment     Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([resourceId])
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
}

model Refund {
  id               String       @id @default(cuid())
  paymentId        String
  amount           Decimal      @db.Decimal(12, 2)
  status           RefundStatus @default(PENDING)
  providerRefundId String?
  reason           String?
  requestedById    String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  payment          Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

// ───────────────────────── Auditoría y sistema ─────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  merchantId String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([merchantId, createdAt])
  @@index([entityType, entityId])
}

model SystemEvent {
  id        String   @id @default(cuid())
  level     String // info | warn | error
  source    String // mercadopago | cron | auth | ...
  message   String
  context   Json?
  merchantId String?
  createdAt DateTime @default(now())

  @@index([level, createdAt])
  @@index([source, createdAt])
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model RateLimitBucket {
  key         String   @id
  count       Int
  windowStart DateTime
}
