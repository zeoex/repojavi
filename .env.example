# ─────────────────────────────────────────────────────────────
# Fedexpress — variables de entorno (copiar a .env y completar)
# NUNCA subas valores reales al repositorio.
# ─────────────────────────────────────────────────────────────

# ── Base de datos (PostgreSQL) ──
# Local (docker compose): postgresql://postgres:postgres@localhost:5432/fedexpress
# Supabase: DATABASE_URL = conexión "Transaction pooler" (puerto 6543) con ?pgbouncer=true&connection_limit=1
#           DIRECT_URL   = conexión directa / "Session pooler" (puerto 5432), usada por las migraciones
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fedexpress"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/fedexpress"
# Base exclusiva para pruebas automatizadas (su nombre debe contener "test")
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fedexpress_test"

# ── Aplicación ──
# URL pública (en producción, https://tu-dominio). Se usa para back_urls y webhooks de Mercado Pago.
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── Sesiones (NextAuth) ──
NEXTAUTH_URL="http://localhost:3000"
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ── Google OAuth ── (Google Cloud Console → Credenciales → ID de cliente OAuth "Aplicación web")
# URI de redirección autorizada: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Login de desarrollo por email (SIN Google). Solo funciona si NODE_ENV != production.
DEV_LOGIN_ENABLED="false"

# ── Cifrado de credenciales de terceros (tokens de Mercado Pago) ──
# 32 bytes en base64. Generar con: openssl rand -base64 32   (si se pierde, los comercios deben reconectar MP)
ENCRYPTION_KEY=""

# ── Mercado Pago (aplicación de la PLATAFORMA, modelo marketplace con OAuth por vendedor) ──
# Tus integraciones → tu aplicación → Credenciales. Configurar Redirect URL: {APP_URL}/api/mercadopago/oauth/callback
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""
# Clave secreta de webhooks (Tus integraciones → Webhooks → "Clave secreta")
MP_WEBHOOK_SECRET=""
# true = rechaza notificaciones sin header x-signature (recomendado una vez verificado que llegan firmadas)
MP_WEBHOOK_REQUIRE_SIGNATURE="false"
# URL de autorización OAuth del país (Argentina)
MP_AUTH_URL="https://auth.mercadopago.com.ar"
MP_API_URL="https://api.mercadopago.com"
# true = pide tokens de prueba en el intercambio OAuth (sandbox)
MP_OAUTH_TEST_TOKEN="true"
# Comisión opcional de la plataforma por venta (%), enviada como marketplace_fee. 0 = sin comisión.
MP_PLATFORM_FEE_PERCENT="0"
# Permite que un comercio pegue el Access Token de un USUARIO DE PRUEBA (solo para sandbox)
MP_ALLOW_MANUAL_CREDENTIALS="false"

# ── Pagos SIMULADOS para demostraciones (comercios sin Mercado Pago conectado) ──
# Quedan marcados como "PAGO SIMULADO". No habilitar en una tienda real.
DEMO_PAYMENTS_ENABLED="false"

# ── Cron (vencimiento de reservas de stock) ──
# Vercel Cron envía Authorization: Bearer ${CRON_SECRET}
CRON_SECRET=""

# ── Almacenamiento de imágenes (opcional, Supabase Storage) ──
# Sin esto, los comercios cargan imágenes por URL https.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="product-images"

# ── Logging ──
# Prisma registra solo errores fuera de desarrollo. Los logs nunca incluyen tokens.
LOG_LEVEL="info"
